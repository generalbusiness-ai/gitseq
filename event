ead and artifact set. Requester ratification, guarded landing with exact-path succession, push, CI and cleanup remain the implementation follow-through.\n","body":{"artifact":"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:25af892556b0614a4583d9cd082dc1afbb564f8a","binding":"assigned","head":"79da95485d131ce20402ba2b1f17e3161279c0f4","head_news_acknowledged":"[\"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:9a77011217fde9b51707f7dfa4afdbdf28ff1962\"]","implementations":"[\"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:fdc12269acf3cd07fb60fde6afa90a2393d09e8d\"]","review_frontier":"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:9a77011217fde9b51707f7dfa4afdbdf28ff1962","review_path":"reviewguard@1","stale":"true","stale_bases":"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:25af892556b0614a4583d9cd082dc1afbb564f8a, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:59cb5cc038e20a0be5421cfc93fe2684cff44516, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:639e72fafeb571be475a54885f3047433ab6da4d, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:9a77011217fde9b51707f7dfa4afdbdf28ff1962, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:e5829151333fb1ede9231036237f0cbdd6e55b74, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:eb68a14b52846a29f0c4236be5589f3d0152c273 stale; retired bases: git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:001b2e3b06105d22946682cb90201bc66c1c6a26, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:0169ac61d80658478db25ce500d46d087c06fdde, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:06542907068280abb3fcdd5bc86c1d49921c390f, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:06bcb7291a174a440c578541c69bf2bd41697ed0 and 117 more","staleness":"artifact, promise, request stale; retired bases: git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:001b2e3b06105d22946682cb90201bc66c1c6a26, git:sh