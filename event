ssed, and make docs passed (internal/docset 101.263s).","body":{"artifact":"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:3247ddb97cf0e638a4666786c22136f2a8da9d56","branch":"request/work-loop-states","head":"13a597114794c9600f020776b24d2744d7b165d3","tests":"focused internal/workroom projection tests passed; focused cmd/gs review/merge guard tests passed; make docs passed (internal/docset 101.263s); diff --check and clean merge-tree against main 8d08315a","verdict":"changes-requested"}}