etached review checkout contains no source edits.","body":{"artifact":"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:94e9d744b46a294f85c1850554f2a9cdb87b32b6","binding":"assigned","head":"643ab9c5f2ec30c2ce4c6240fd251236abc019c0","head_news_acknowledged":"[\"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:678c6350388351c587a5889b0d535c2e388734c1\"]","implementations":"[\"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:a4c569b1cddfb0db72f9239488851f19a291906f\"]","review_frontier":"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:3a4a54e46766c73f8ce6220b949303cf9816bba2","review_path":"reviewguard@1","stale":"true","stale_bases":"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:1353cee47c966b35aa33a96e8f0f28b0c474d2fa, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:18d4028d6288f5514b46f2bffe7797ed5b7720e7, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:20682a3e198dc8e07f440df8b9af31d907d4d852, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:27e8eeb36d01ddda03c565c5fe1867f4c62a3bbb, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:29a6373a02d417caec08fa428d4d8f726e642886, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:2ae3232f5fa77a4e49ba93fe360ee00b02eb4c54, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:4d923e6ba0af86c5e7b73c384ee826c61becc03e, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:500655949d4d5dc67ac6e36c3348bda727a155ce, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:595bacd4097ce0f1a6bd8c4e5ee9c934e3e4963a, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:59b62193b8ec6dd8abf4f192f74d6c317f457874, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:5c60ed0c1a84698b3747fdbb84e80fefa68081e0, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:678c6350388351c587a5889b0d535c2e388734c1, git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:6b158b11390b00627f403837ab96f7fb2a83ebfa, git:s