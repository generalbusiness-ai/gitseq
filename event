ns provide the required exact-head gates. Keep the work on its existing commitment, cite this verdict and request fresh exact-head review.","body":{"artifact":"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:8c069a2609c1138e23d4442917972cc695dcced3","head":"952282b0b0d0ec48365b15670bd3da9a8f919ea8","head_news_acknowledged":"[\"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:db683a79abff384f62b7e718faee35ba6fa4ecd2\"]","review_frontier":"git:sha1:5d2622748872b7e2dec3fe5c59e4be73a35e0bc8#git:sha1:21423613ce25fa0bc0dd6b1e71c73a784187e2e2","review_path":"reviewguard@1","verdict":"changes-requested"}}