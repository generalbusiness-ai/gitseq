(
  $stock := rows.stock_row;
  $available := $stock ? $stock.available : 0;
  $receiving := meta.event_type = "stock_received";
  $effective := $receiving or ($stock and $stock.available >= event.qty);
  {
    "decision": $effective ? "effective" : "ineffective",
    "facts": $effective ? [] : [{"kind": "insufficient-stock"}],
    "tables": $effective ? (
      $receiving ? {
        "stock": {"upsert": [{"sku": event.sku, "available": $available + event.qty}]}
      } : {
        "stock": {"upsert": [{"sku": event.sku, "available": $stock.available - event.qty}]},
        "reservations": {"insert": [event]}
      }
    ) : {}
  }
)
